{
    "uid": "insightia-red",
    "title": "Insightia - RED",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
        "from": "now-10m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Rate: requisições por segundo",
            "datasource": {
                "type": "prometheus",
                "uid": "prom"
            },
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "req/s",
                    "expr": "sum(rate(http_requests_total[1m]))"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Errors: taxa de erro 5xx",
            "datasource": {
                "type": "prometheus",
                "uid": "prom"
            },
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "% de erros",
                    "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_requests_total[1m]))"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Duration: latência",
            "datasource": {
                "type": "prometheus",
                "uid": "prom"
            },
            "gridPos": {
                "h": 9,
                "w": 8,
                "x": 16,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "p50",
                    "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))"
                },
                {
                    "refId": "B",
                    "legendFormat": "p95",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))"
                }
            ]
        }
    ]
}